%% Лист 3. Функциональная модель IDEF0.
%% Контекст A-0 и декомпозиция A0.
flowchart LR
    subgraph A0["A0. Управление учебным процессом АС ОУДО"]
        A1["A1. Управлять<br/>справочниками"]
        A2["A2. Вести договоры<br/>и записи на курс"]
        A3["A3. Вести задания<br/>и оценки"]
        A4["A4. Формировать<br/>отчётность"]
    end

    %% Входы
    Inputs1[/"Заявления<br/>студентов"/] -->|стрелка ввода| A2
    Inputs2[/"Учебные планы<br/>стандарты"/] -->|стрелка ввода| A1
    Inputs3[/"Результаты<br/>выполнения"/] -->|стрелка ввода| A3

    %% Управление
    Mgmt1[["Образовательные<br/>стандарты"]] -.->|управление| A1
    Mgmt2[["Локальные<br/>нормативные акты"]] -.->|управление| A2
    Mgmt3[["Положение<br/>о промежуточной<br/>аттестации"]] -.->|управление| A3
    Mgmt4[["Регламент<br/>отчётности"]] -.->|управление| A4

    %% Механизмы
    Mech1{{"Сотрудник"}} ==>|механизм| A1
    Mech1 ==>|механизм| A2
    Mech2{{"Преподаватель"}} ==>|механизм| A3
    Mech3{{"АИС ОУДО<br/>(БД + UI)"}} ==>|механизм| A1
    Mech3 ==>|механизм| A2
    Mech3 ==>|механизм| A3
    Mech3 ==>|механизм| A4

    %% Выходы
    A1 -->|справочники<br/>дисциплин и курсов| A2
    A2 -->|записи на курс| A3
    A3 -->|массив оценок| A4
    A4 -->|отчёты,<br/>печатные формы| Outputs1[/"Отчёт об<br/>успеваемости"/]
    A4 -->|сводки| Outputs2[/"Аналитика<br/>для администрации"/]
